# Node 24, one application instance with a persistent local disk.
APP_URL=http://localhost:3000
SANGOPASS_DATABASE_PATH=./data/sangopass.sqlite

# Keep sandbox until your merchant account and public HTTPS callback are tested.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Optional password recovery email. Use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=
