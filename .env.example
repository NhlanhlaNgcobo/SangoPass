# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# APP_URL sets the accepted request origin, the session cookie Secure flag and
# every absolute payment and recovery link. In production it MUST be https://
# or the server refuses to start.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Storage and identity
# ---------------------------------------------------------------------------
# sqlite   one server with a persistent disk, no cloud account needed (default)
# firebase Firestore + Firebase Authentication; required on serverless hosts
# Leave unset to auto-select: firebase when the credentials below are present.
SANGOPASS_BACKEND=sqlite

# SQLite backend only. Never point this at ephemeral or serverless storage.
SANGOPASS_DATABASE_PATH=./data/sangopass.sqlite

# Firebase backend. Create the project, enable Firestore in Native mode and
# Email/Password sign-in, then paste a service-account key. See docs/FIREBASE.md
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole private key on one line, keeping the literal \n sequences.
FIREBASE_PRIVATE_KEY=
# The Web API key from Project settings > General. Used to verify passwords.
FIREBASE_API_KEY=

# Local emulator instead of a real project (no Firebase account required):
#   firebase emulators:start --only auth,firestore --project demo-sangopass
# FIREBASE_PROJECT_ID=demo-sangopass
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------------------------------------------------------------------------
# Payments (PayFast)
# ---------------------------------------------------------------------------
# Keep sandbox until your merchant account and public HTTPS callback are tested.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Required for enrolment/welcome emails, password recovery and the renewal
# reminders sent by `npm run maintenance`.
RESEND_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Showcase deployment
# ---------------------------------------------------------------------------
# Serves the marketing site plus the interactive demo, which runs entirely in
# the visitor's browser. Nothing is stored, so ephemeral hosting like Vercel is
# fine and the boot guard allows it. Sign-in screens say accounts are switched
# off. Leave unset for a real deployment.
SANGOPASS_DEMO=false

# ---------------------------------------------------------------------------
# Maintenance
# ---------------------------------------------------------------------------
RENEWAL_REMINDER_DAYS=7
AUDIT_RETENTION_DAYS=400
