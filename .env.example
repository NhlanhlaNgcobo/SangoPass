# Node 24, one application instance with a persistent local disk.
APP_URL=http://localhost:3000
SANGOPASS_DATABASE_PATH=./data/sangopass.sqlite

# Keep sandbox until your merchant account and public HTTPS callback are tested.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Required for automatic enrolment/welcome emails and password recovery.
# Use a verified sender domain and a publicly reachable APP_URL above.
RESEND_API_KEY=
EMAIL_FROM=
