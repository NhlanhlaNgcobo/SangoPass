{
  "name": "sangopass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib tests types",
    "test:http": "node scripts/http-smoke.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
