{
  "$comment": "Composite indexes for every multi-field query in lib/server. Single-field equality (token, hash, email, loginCode, userId) is served by Firestore's automatic indexes. Deploy with: firebase deploy --only firestore:indexes",
  "indexes": [
    {
      "collectionGroup": "visitors",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "orgId", "order": "ASCENDING" },
        { "fieldPath": "visitDate", "order": "DESCENDING" },
        { "fieldPath": "arrival", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "visitors",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "orgId", "order": "ASCENDING" },
        { "fieldPath": "propertyId", "order": "ASCENDING" },
        { "fieldPath": "visitDate", "order": "DESCENDING" },
        { "fieldPath": "arrival", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "visitors",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "orgId", "order": "ASCENDING" },
        { "fieldPath": "hostId", "order": "ASCENDING" },
        { "fieldPath": "visitDate", "order": "DESCENDING" },
        { "fieldPath": "arrival", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "visitors",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "orgId", "order": "ASCENDING" },
        { "fieldPath": "hostId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" }
      ]
    },
    {
      "$comment": "Guest slots in use for a unit (maxActiveGuests).",
      "collectionGroup": "visitors",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "unitId", "order": "ASCENDING" },
        { "fieldPath": "active", "order": "ASCENDING" }
      ]
    },
    {
      "$comment": "A unit's bookings within one calendar month (sleepover nights).",
      "collectionGroup": "visitors",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "unitId", "order": "ASCENDING" },
        { "fieldPath": "visitDate", "order": "ASCENDING" }
      ]
    },
    {
      "$comment": "The manager maintenance queue: most urgent first, newest within a level.",
